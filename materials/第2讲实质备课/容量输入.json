    },
    {
      "id": "M3",
      "section": "upper",
      "kind": "main",
      "source_heading": "三 中国近代探索 看见国家权力根据和行使方式的变化",
      "speech_subheading": "讲述"
    },
    {
      "id": "M4",
      "section": "upper",
      "kind": "main",
      "source_heading": "四 根据地探索与新中国四部完整文本 在一张全景中各归其位",
      "speech_subheading": "讲述"
    },
    {
      "id": "M5",
      "section": "upper",
      "kind": "main",
      "source_heading": "五 1982年宪法怎样形成 先分清文件 日期与说明",
      "speech_subheading": "讲述"
    },
    {
      "id": "M6",
      "section": "upper",
      "kind": "main",
      "source_heading": "六 同样写保护人身自由 权力安排究竟变了什么",
      "speech_subheading": "讲述"
    },
    {
      "id": "M7",
      "section": "upper",
      "kind": "main",
      "source_heading": "七 第一学时收束 变化不靠年份自己说明",
      "speech_subheading": "讲述"
    },
    {
      "id": "M8",
      "section": "lower",
      "kind": "main",
      "source_heading": "八 1988年的土地修改 改变使用安排是否等于改变所有权",
      "speech_subheading": "讲述"
    },
    {
      "id": "M9",
      "section": "lower",
      "kind": "main",
      "source_heading": "九 五次修正都有位置 不把每次变化讲成从零开始",
      "speech_subheading": "讲述"
    },
    {
      "id": "M10",
      "section": "lower",
      "kind": "main",
      "source_heading": "十 2018年监察入宪 一处新机关为什么需要多处改文",
